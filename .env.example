# Copy to .env and adjust. No secrets belong in this file.

# Backend
VIDEOCUT_HOST=127.0.0.1
VIDEOCUT_PORT=8000

# Frontend dev server (proxies /api to the backend)
VIDEOCUT_FRONTEND_PORT=5173

# FFmpeg is an external executable. Leave empty to resolve from PATH. Each may be an
# executable or its folder.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional backend settings
# Opt-in hardware encoder: h264_nvenc or h264_qsv. Empty (default) means software.
VIDEOCUT_HARDWARE_ENCODER=
# Upload size limit in bytes (default 8 GiB). Uploads themselves arrive in a later package.
VIDEOCUT_MAX_UPLOAD_BYTES=
