# Copy to .env and adjust. No secrets belong in this file.

# Backend
VIDEOCUT_HOST=127.0.0.1
VIDEOCUT_PORT=8000

# Frontend dev server (proxies /api to the backend)
VIDEOCUT_FRONTEND_PORT=5173

# FFmpeg is an external executable (used from a later package on).
# Leave empty to resolve from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
